{
  "manifest_version": 3,
  "name": "Coursera Helper — Quiz Cleaner & AI Solver",
  "version": "2.0.0",
  "description": "Thanh bên thông minh cố định: tự động loại bỏ prompt injection và giải trắc nghiệm Coursera bằng Google Gemini AI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Mở Coursera Helper Side Panel"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.coursera.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.coursera.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
