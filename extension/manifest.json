{
  "manifest_version": 3,
  "name": "Coursera Helper — Quiz Cleaner & AI Solver",
  "version": "2.4.4",
  "description": "Tự động loại bỏ prompt injection, giải trắc nghiệm bằng Gemini AI, tua video và auto skip bài học Coursera.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mở Coursera Helper Side Panel"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.coursera.org/*",
    "*://coursera.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://coursera-helper.vercel.app/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.coursera.org/*", "*://coursera.org/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.coursera.org/*",
        "*://coursera.org/*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.coursera.org/*",
        "*://coursera.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}