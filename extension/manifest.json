{
  "manifest_version": 3,
  "name": "Coursera Helper — Quiz Cleaner & AI Solver",
  "version": "1.0.0",
  "description": "Tự động loại bỏ prompt injection bẫy, watermark và giải đề Coursera chuyên nghiệp bằng Google Gemini AI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png",
    "default_title": "Coursera Helper"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.coursera.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.coursera.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
